{
  "info": {
    "name": "Gifty API",
    "description": "API for the Gifty gift vouchers platform. All endpoints are organized by resource. Set the global variables and Bearer token for easy testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000/api/v1" },
    { "key": "token", "value": "your-jwt-token-here" },
    { "key": "test_email", "value": "test_user_123456@testuser.com" },
    { "key": "test_product_id", "value": "your-product-id-here" },
    { "key": "test_store_id", "value": "your-store-id-here" },
    { "key": "test_order_id", "value": "your-order-id-here" },
    { "key": "mp_token", "value": "your-mp-token-here" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"yourPassword\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] },
            "description": "Login to get JWT token."
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"{{test_email}}\",\n  \"password\": \"yourPassword\"\n}" },
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] },
            "description": "Register a new user."
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{test_email}}\"\n}" },
            "url": { "raw": "{{base_url}}/auth/forgot-password", "host": ["{{base_url}}"], "path": ["auth", "forgot-password"] },
            "description": "Request password reset."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"reset-token-here\",\n  \"password\": \"newPassword\",\n  \"passwordConfirm\": \"newPassword\",\n  \"email\": \"{{test_email}}\"\n}" },
            "url": { "raw": "{{base_url}}/auth/reset-password", "host": ["{{base_url}}"], "path": ["auth", "reset-password"] },
            "description": "Reset password with token."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/users", "host": ["{{base_url}}"], "path": ["users"] },
            "description": "Get all users (admin only)."
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"New User\",\n  \"email\": \"newuser@example.com\",\n  \"password\": \"password\",\n  \"role\": \"customer\"\n}" },
            "url": { "raw": "{{base_url}}/users", "host": ["{{base_url}}"], "path": ["users"] },
            "description": "Create a new user (admin only)."
          }
        },
        {
          "name": "Get User By ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/users/{{user_id}}", "host": ["{{base_url}}"], "path": ["users", "{{user_id}}"] },
            "description": "Get user by ID."
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Name\"\n}" },
            "url": { "raw": "{{base_url}}/users/{{user_id}}", "host": ["{{base_url}}"], "path": ["users", "{{user_id}}"] },
            "description": "Update user by ID."
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/users/{{user_id}}", "host": ["{{base_url}}"], "path": ["users", "{{user_id}}"] },
            "description": "Delete user by ID."
          }
        }
      ]
    },
    {
      "name": "Stores",
      "item": [
        {
          "name": "Get All Stores",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/stores", "host": ["{{base_url}}"], "path": ["stores"] },
            "description": "Get all stores."
          }
        },
        {
          "name": "Create Store",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Store\",\n  \"ownerId\": \"{{user_id}}\",\n  \"email\": \"store@example.com\",\n  \"phone\": \"+1234567890\",\n  \"address\": \"123 Store St\"\n}" },
            "url": { "raw": "{{base_url}}/stores", "host": ["{{base_url}}"], "path": ["stores"] },
            "description": "Create a new store."
          }
        },
        {
          "name": "Get Store By ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/stores/{{store_id}}", "host": ["{{base_url}}"], "path": ["stores", "{{store_id}}"] },
            "description": "Get store by ID."
          }
        },
        {
          "name": "Update Store",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Store\"\n}" },
            "url": { "raw": "{{base_url}}/stores/{{store_id}}", "host": ["{{base_url}}"], "path": ["stores", "{{store_id}}"] },
            "description": "Update store by ID."
          }
        },
        {
          "name": "Delete Store",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/stores/{{store_id}}", "host": ["{{base_url}}"], "path": ["stores", "{{store_id}}"] },
            "description": "Delete store by ID."
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/products", "host": ["{{base_url}}"], "path": ["products"] },
            "description": "Get all products."
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"storeId\": \"{{store_id}}\",\n  \"name\": \"Test Product\",\n  \"description\": \"A product\",\n  \"price\": 100.0,\n  \"isActive\": true\n}" },
            "url": { "raw": "{{base_url}}/products", "host": ["{{base_url}}"], "path": ["products"] },
            "description": "Create a new product."
          }
        },
        {
          "name": "Get Product By ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/products/{{product_id}}", "host": ["{{base_url}}"], "path": ["products", "{{product_id}}"] },
            "description": "Get product by ID."
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Product\"\n}" },
            "url": { "raw": "{{base_url}}/products/{{product_id}}", "host": ["{{base_url}}"], "path": ["products", "{{product_id}}"] },
            "description": "Update product by ID."
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/products/{{product_id}}", "host": ["{{base_url}}"], "path": ["products", "{{product_id}}"] },
            "description": "Delete product by ID."
          }
        }
      ]
    },
    {
      "name": "Vouchers",
      "item": [
        {
          "name": "Get All Vouchers",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/vouchers", "host": ["{{base_url}}"], "path": ["vouchers"] },
            "description": "Get all vouchers."
          }
        },
        {
          "name": "Create Voucher",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"storeId\": \"{{store_id}}\",\n  \"productId\": \"{{product_id}}\",\n  \"amount\": 100,\n  \"expirationDate\": \"2025-12-31T23:59:59.000Z\",\n  \"senderName\": \"Sender\",\n  \"senderEmail\": \"sender@example.com\",\n  \"receiverName\": \"Receiver\",\n  \"receiverEmail\": \"receiver@example.com\",\n  \"message\": \"Enjoy!\",\n  \"template\": \"template1\"\n}" },
            "url": { "raw": "{{base_url}}/vouchers", "host": ["{{base_url}}"], "path": ["vouchers"] },
            "description": "Create a new voucher."
          }
        },
        {
          "name": "Get Voucher By ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/vouchers/{{voucher_id}}", "host": ["{{base_url}}"], "path": ["vouchers", "{{voucher_id}}"] },
            "description": "Get voucher by ID."
          }
        },
        {
          "name": "Redeem Voucher",
          "request": {
            "method": "PUT",
            "url": { "raw": "{{base_url}}/vouchers/code/{{voucher_code}}/redeem", "host": ["{{base_url}}"], "path": ["vouchers", "code", "{{voucher_code}}", "redeem"] },
            "description": "Redeem voucher by code."
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Get All Orders",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/orders", "host": ["{{base_url}}"], "path": ["orders"] },
            "description": "Get all orders."
          }
        },
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"customerId\": \"{{user_id}}\",\n  \"voucher\": {\n    \"storeId\": \"{{store_id}}\",\n    \"productId\": \"{{product_id}}\",\n    \"amount\": 100,\n    \"expirationDate\": \"2025-12-31T23:59:59.000Z\",\n    \"senderName\": \"Sender\",\n    \"senderEmail\": \"sender@example.com\",\n    \"receiverName\": \"Receiver\",\n    \"receiverEmail\": \"receiver@example.com\",\n    \"message\": \"Enjoy!\",\n    \"template\": \"template1\"\n  },\n  \"paymentDetails\": {\n    \"paymentId\": \"mock_123456\",\n    \"paymentEmail\": \"{{test_email}}\",\n    \"amount\": 100,\n    \"provider\": \"mercadopago\"\n  }\n}" },
            "url": { "raw": "{{base_url}}/orders", "host": ["{{base_url}}"], "path": ["orders"] },
            "description": "Create a new order."
          }
        },
        {
          "name": "Get Order By ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/orders/{{order_id}}", "host": ["{{base_url}}"], "path": ["orders", "{{order_id}}"] },
            "description": "Get order by ID."
          }
        },
        {
          "name": "Get Orders By Customer ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/orders/customer/{{user_id}}", "host": ["{{base_url}}"], "path": ["orders", "customer", "{{user_id}}"] },
            "description": "Get orders by customer ID."
          }
        },
        {
          "name": "Get Order By Voucher Code",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/orders/voucher/{{voucher_code}}", "host": ["{{base_url}}"], "path": ["orders", "voucher", "{{voucher_code}}"] },
            "description": "Get order by voucher code."
          }
        },
        {
          "name": "Redeem Order Voucher",
          "request": {
            "method": "PUT",
            "url": { "raw": "{{base_url}}/orders/voucher/{{voucher_code}}/redeem", "host": ["{{base_url}}"], "path": ["orders", "voucher", "{{voucher_code}}", "redeem"] },
            "description": "Redeem voucher by code."
          }
        },
        {
          "name": "Resend Voucher Emails",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/orders/{{order_id}}/resend-emails", "host": ["{{base_url}}"], "path": ["orders", "{{order_id}}", "resend-emails"] },
            "description": "Resend voucher emails for an order."
          }
        },
        {
          "name": "Download Voucher PDF",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/orders/{{order_id}}/download-pdf", "host": ["{{base_url}}"], "path": ["orders", "{{order_id}}", "download-pdf"] },
            "description": "Download voucher PDF for an order."
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Process Mercado Pago Payment",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"{{order_id}}\",\n  \"token\": \"{{mp_token}}\",\n  \"issuer_id\": \"default\",\n  \"payment_method_id\": \"visa\",\n  \"transaction_amount\": 100,\n  \"installments\": 1,\n  \"payer\": {\n    \"email\": \"{{test_email}}\"\n  }\n}" },
            "url": { "raw": "{{base_url}}/payment/process_payment", "host": ["{{base_url}}"], "path": ["payment", "process_payment"] },
            "description": "Process a Mercado Pago payment for an order."
          }
        }
      ]
    }
  ]
}
